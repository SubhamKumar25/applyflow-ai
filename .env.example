# ============================================
# ApplyFlow AI — Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ---------- Google Sign-In (same Web client ID as VITE_GOOGLE_CLIENT_ID in frontend) ----------
GOOGLE_CLIENT_ID=

# ---------- CORS (production) ----------
# Comma-separated frontend origins, e.g. https://applyflow.vercel.app
# Leave empty for local dev (wildcard).
CORS_ORIGINS=

# ---------- General ----------
APP_ENV=development
APP_NAME=ApplyFlow AI
SECRET_KEY=change-me-to-a-random-secret-key

# ---------- MongoDB ----------
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=applyflow_ai

# ---------- JWT ----------
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ---------- AI Provider ----------
# Options: "openai" or "gemini"
AI_PROVIDER=openai

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# ---------- Google Gemini ----------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ---------- Automation ----------
DAILY_APPLY_LIMIT=20
PLAYWRIGHT_HEADLESS=true

# ---------- Notifications ----------
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ---------- Scheduler ----------
SCHEDULER_ENABLED=false
SCHEDULER_CRON_HOUR=9
SCHEDULER_CRON_MINUTE=0

# ---------- File Uploads ----------
MAX_RESUME_SIZE_MB=10
UPLOAD_DIR=./resumes
