# Frontend (Vite) — copy to frontend/.env.local for local dev
# Production: set these in Vercel Project → Settings → Environment Variables

# Public API (no /api suffix unless your API is mounted there)
VITE_API_URL=http://localhost:8000

# Google Identity — Web client ID (same OAuth 2.0 Client ID string as backend GOOGLE_CLIENT_ID)
# Create: Google Cloud Console → APIs & Services → Credentials → OAuth client ID → Web application
# Authorized JavaScript origins: http://localhost:5173, https://your-app.vercel.app
VITE_GOOGLE_CLIENT_ID=
